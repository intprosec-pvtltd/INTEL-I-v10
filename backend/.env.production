# ---------- PostgreSQL / PostGIS ----------
POSTGRES_USER=intel_i
POSTGRES_PASSWORD=intprosec2026
POSTGRES_DB=cctv_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://intel_i:intprosec2026@postgres:5432/cctv_db
AUTO_CREATE_SCHEMA=false

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_PROTOCOL=2
REDIS_PREFIX=intel-i

# ---------- Kafka ----------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=intel-i
KAFKA_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_RAW_ALERT_TOPIC=cctv.alerts.raw
KAFKA_SAVED_ALERT_TOPIC=cctv.alerts.saved
KAFKA_CONSUMER_GROUP=intel-i-db-consumer
KAFKA_CONNECT_RETRIES=10
KAFKA_CONNECT_RETRY_DELAY=2
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SAVED_ALERT_WS_ENABLED=true
KAFKA_SAVED_ALERT_WS_REQUIRED=false
INTELI_KAFKA_VEHICLE_TOPIC=intel-i.vehicle.observation.v1

# ---------- MinIO ----------
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_REQUIRED=true
OBJECT_STORAGE_ALLOW_LOCAL_FALLBACK=false
OBJECT_STORAGE_CACHE_DIR=/data/object-cache
OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
OBJECT_STORAGE_READ_TIMEOUT_SECONDS=120
OBJECT_STORAGE_RETRIES=3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=intel_i_app
MINIO_SECRET_KEY=IntelI-MinIO-2026-Strong-Password
MINIO_ROOT_USER=intel_i_app
MINIO_ROOT_PASSWORD=IntelI-MinIO-2026-Strong-Password
MINIO_VIDEO_BUCKET=intel-i-uploaded-videos
MINIO_SECURE=false
MINIO_CERT_CHECK=true
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ---------- OpenSearch ----------
OPENSEARCH_ENABLED=true
OPENSEARCH_REQUIRED=true
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USERNAME=admin
