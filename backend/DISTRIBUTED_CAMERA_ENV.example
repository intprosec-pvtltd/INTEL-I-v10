# INTEL-I distributed live-camera worker migration settings.
# Merge these keys into your existing secret-managed environment. Do NOT copy
# real credentials into source control.

INTEL_I_DISTRIBUTED_CAMERA_WORKERS=true
INTEL_I_MAX_CAMERAS_PER_WORKER=5
INTEL_I_CAMERA_LEASE_TTL=30
INTEL_I_CAMERA_LEASE_RENEW_SECONDS=10
INTEL_I_CAMERA_DISCOVERY_SECONDS=3
INTEL_I_WORKER_HEARTBEAT_TTL=30
INTEL_I_CAMERA_RUNTIME_TTL=60
INTEL_I_WORKER_SHUTDOWN_WAIT_SECONDS=8
INTEL_I_WORKER_PREVIEW_PORT=9101

# Required in production. Generate a long random value and provide the same
# value to API and camera-worker processes.
INTEL_I_WORKER_PREVIEW_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Per worker outside Kubernetes. In Kubernetes POD_IP is injected and the
# worker derives http://<POD_IP>:9101 automatically.
# INTEL_I_WORKER_ID=worker-01
# INTEL_I_WORKER_PREVIEW_ADVERTISE_URL=http://worker-01:9101

# Existing INTEL-I Prometheus protection also applies to worker /metrics.
PROMETHEUS_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Central inference architecture
CENTRAL_INFERENCE_ENABLED=true
INFERENCE_PROCESS_SPLIT_ENABLED=true
AI_BATCHING_ENABLED=true
INFERENCE_SERVICE_URL=http://inference-worker:9300
INFERENCE_GPU_REQUIRED=true
CAMERA_SOURCE_FPS=25
PREVIEW_FPS=12
IDLE_DETECTION_FPS=2
ACTIVE_DETECTION_FPS=5
INCIDENT_DETECTION_FPS=8
BEHAVIOUR_FPS=3
FRS_MAX_FPS=2
ANPR_MAX_FPS=3
REID_INTERVAL_SECONDS=2
INFERENCE_BATCH_SIZE=16
INFERENCE_BATCH_WAIT_MS=20
CAMERA_FRAME_QUEUE_SIZE=2
GPU_QUEUE_MAX_SIZE=100
VIDEO_HW_DECODE_ENABLED=true
VIDEO_DECODE_DEVICE=auto
TENSORRT_ENABLED=true
TENSORRT_PRECISION=fp16
ADAPTIVE_FPS_ENABLED=true
PRIORITY_INFERENCE_ENABLED=true
INFERENCE_BACKPRESSURE_ENABLED=true
DARKIR_ENABLED=true
DARKIR_AUTO_TRIGGER=true
DARKIR_BRIGHTNESS_THRESHOLD=55
EDSR_ENABLED=true
EDSR_AUTO_TRIGGER=true
EDSR_MIN_ROI_WIDTH=96
EDSR_MIN_ROI_HEIGHT=48
