# Merge with existing production configuration. Supply secrets separately.
INTEL_I_INFERENCE_MODE=triton
CENTRAL_INFERENCE_ENABLED=true
INFERENCE_PROCESS_SPLIT_ENABLED=true
INTEL_I_DISTRIBUTED_CAMERA_WORKERS=true
INTEL_I_MAX_CAMERAS_PER_WORKER=10
INFERENCE_SERVICE_URL=http://inference-worker:9300
INTEL_I_TRITON_GRPC_URL=triton:8001
INTEL_I_TRITON_MODEL=intel_i_pipeline
INTEL_I_TRITON_TIMEOUT_MS=10000
INTEL_I_TRITON_MAX_RETRIES=2
INFERENCE_FRAME_TTL_MS=500
INFERENCE_BATCH_SIZE=16
INFERENCE_BATCH_WAIT_MS=5
GPU_QUEUE_MAX_SIZE=100
IDLE_DETECTION_FPS=2
ACTIVE_DETECTION_FPS=5
INCIDENT_DETECTION_FPS=5
CRITICAL_DETECTION_FPS=5
ADAPTIVE_FPS_ENABLED=true
INFERENCE_BATCH_FALLBACK_ENABLED=false
VIDEO_HW_DECODE_ENABLED=false
GPU_PREPROCESSING_ENABLED=false
TENSORRT_ENABLED=false
PRIMARY_DETECTOR_TENSORRT_ENGINE=
# Set only in Triton after building and validating engines:
# INTEL_I_TENSORRT_MANIFEST=/app/models/tensorrt/triton-engines.json
# Existing ANPR TensorRT/SAHI switches are preserved; validate them separately.
# Required existing secrets: DATABASE_URL, JWT secret, encryption key,
# INFERENCE_INTERNAL_TOKEN, INTEL_I_WORKER_PREVIEW_TOKEN, FRS_INTERNAL_TOKEN,
# ANPR_OCR_INTERNAL_TOKEN, object-store credentials, and HTTPS FRONTEND_URL.
